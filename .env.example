NODE_ENV=development
SERVER_PORT=8080

# Comma-separated list of allowed frontend origins.
# Required when the frontend sends credentials (cookies) with requests.
# Production origins must use HTTPS and cannot contain paths or wildcards.
# OAuth redirect after Google login uses the first origin in this list.
# SEC-05 CSRF Origin/Referer checks use this same allowlist — include every
# browser origin that talks to the API (public frontend + dashboard_admin).
# Local: Next public site :3000, dashboard_admin :3001 (or whichever ports you use).
# Prod: replace placeholders with real Vercel/custom domains.
# Example: http://localhost:3000,http://localhost:3001,https://frontend-seatrans.vercel.app,https://dashboard-admin.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://frontend-seatrans.vercel.app,https://dashboard-admin.example.com

# Trust X-Forwarded-For / CF-Connecting-IP only when every public path to this
# API goes through a known reverse proxy (nginx, Cloudflare, Render, etc.).
# Leave unset/false when clients can hit the origin directly — otherwise
# attackers can forge XFF to rotate IPs and bypass login lockout (SEC HIGH).
# true/1 = trust 1 hop; N = trust N hops. configure-app sets Express trust proxy.
# TRUST_PROXY=1

DB_URL=postgresql://postgres:secret@localhost:5432/seatrans

# Remote Postgres requires SSL. `sslmode=verify-ca` and `verify-full` always
# enforce certificate verification; DB_SSL_REJECT_UNAUTHORIZED=false cannot
# weaken those URL modes. Use `sslmode=require` only for encryption without CA
# verification, or configure DB_SSL_CA_PATH for a private/managed CA.
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false

# Fallback DB config (DatabaseModule will use these when DB_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=secret
DB_DATABASE=seatrans

# Leave DB_URL empty to use fallback config above
# DB_URL=

# Postgres pool + statement/lock timeouts (see docs/DB_CONNECTION_BUDGET.md)
# DB_POOL_MAX=10
# DB_POOL_CONNECTION_TIMEOUT_MS=5000
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_LOCK_TIMEOUT_MS=10000

# Dashboard clients send expectedVersion; production always enforces it.
EPDA_REQUIRE_EXPECTED_VERSION=true

APP_UPLOAD_DIR=./uploads

# SEC-04 login throttle (in-memory per process — see LoginThrottleService).
# Multi-replica deployments do NOT share counters; use Redis/edge WAF before
# scaling auth horizontally, or accept N× effective attempts across pods.
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_MS=900000

# Use a cryptographically random value of at least 32 characters in production.
APP_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Idle / sliding token TTL (legacy APP_JWT_EXPIRATION still accepted as fallback)
APP_JWT_IDLE=1h
APP_JWT_EXPIRATION=1h
# Re-issue cookie when remaining idle TTL is below this
APP_JWT_SLIDE_BEFORE=15m
# Hard ceiling from login (auth_time); activity cannot extend past this
APP_JWT_ABSOLUTE=12h
# Longer absolute only when remember=true AND user roleGroup=EXTERNAL
APP_JWT_ABSOLUTE_REMEMBER=7d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth2/callback/google
# GOOGLE_OAUTH_TIMEOUT_MS=15000
DEFAULT_OAUTH_ROLE=ROLE_CUSTOMER

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_TIMEOUT_MS=60000

# R2 object storage (optional)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_REQUEST_TIMEOUT_MS=30000
# R2_FOLDER_SYNC_MAX_OBJECTS=250

# Booking PDF / partner import concurrency + limits
# BOOKING_PDF_RENDER_CONCURRENCY=2
# BOOKING_PARTNER_IMPORT_MAX_ROWS=2000
# BOOKING_PARTNER_IMPORT_MAX_COLUMNS=64
# BOOKING_PARTNER_IMPORT_PARSE_CONCURRENCY=1

# --- P3 scaling (optional; sync paths remain default) ---
# Redis enables distributed throttling + short public catalog cache + BullMQ.
# REDIS_URL=redis://localhost:6379/0
# Feature flag for background jobs (booking-partner XLSX import async endpoints).
# When true without REDIS_URL, uses an in-process bounded queue.
# QUEUE_ENABLED=false
# QUEUE_CONCURRENCY=1
# QUEUE_MAX_PENDING=20
# Short TTL for public provinces / service-types cache (Redis only).
# PUBLIC_CATALOG_CACHE_TTL_MS=60000
# Required for BullMQ multi-replica async import: shared volume path mounted
# identically on every API/worker process. Without it, async enqueue returns 503
# (use sync import endpoints instead). In-process queue does not need this.
# IMPORT_JOB_SHARED_DIR=/var/seatrans/import-jobs

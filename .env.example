SERVER_PORT=8080

# Comma-separated list of allowed frontend origins.
# Required when the frontend sends credentials (cookies) with requests.
# OAuth redirect after Google login uses the first origin in this list.
# Example: http://localhost:3000,https://frontend-seatrans.vercel.app
CORS_ORIGINS=http://localhost:3000,https://frontend-seatrans.vercel.app

DB_URL=postgresql://postgres:secret@localhost:5432/seatrans
# Apply backend-local TypeORM migrations on application startup.
DB_MIGRATIONS_RUN=false

# Remote Postgres requires SSL. `sslmode=verify-ca` and `verify-full` always
# enforce certificate verification; DB_SSL_REJECT_UNAUTHORIZED=false cannot
# weaken those URL modes. Use `sslmode=require` only for encryption without CA
# verification, or configure DB_SSL_CA_PATH for a private/managed CA.
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false

# Fallback DB config (DatabaseModule will use these when DB_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=secret
DB_DATABASE=seatrans

# Leave DB_URL empty to use fallback config above
# DB_URL=

APP_UPLOAD_DIR=./uploads
APP_UPLOAD_INQUIRY_DIR=./uploads/inquiries
APP_UPLOAD_MAX_FILE_SIZE=10485760
APP_UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf,doc,docx

APP_JWT_SECRET=super-secret
# Idle / sliding token TTL (legacy APP_JWT_EXPIRATION still accepted as fallback)
APP_JWT_IDLE=1h
APP_JWT_EXPIRATION=1h
# Re-issue cookie when remaining idle TTL is below this
APP_JWT_SLIDE_BEFORE=15m
# Hard ceiling from login (auth_time); activity cannot extend past this
APP_JWT_ABSOLUTE=12h
# Longer absolute only when remember=true AND user roleGroup=EXTERNAL
APP_JWT_ABSOLUTE_REMEMBER=7d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth2/callback/google
DEFAULT_OAUTH_ROLE=ROLE_CUSTOMER

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

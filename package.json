  "scripts": {
    "build": "nest build",
    "dev": "nest build && nest start --watch",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:migrate:epda-hardening": "node scripts/run-epda-parameter-hardening.mjs",
    "db:migrate:epda-hardening:data": "node scripts/run-epda-parameter-hardening.mjs --phase=data",
    "db:migrate:epda-hardening:validate": "node scripts/run-epda-parameter-hardening.mjs --phase=validate",
    "db:migrate:runtime-schema": "node scripts/run-runtime-schema-migration.mjs",
    "db:migrate:relational-integrity": "node scripts/run-relational-integrity-expand.mjs",
    "db:migrate:roles-name-uniqueness": "node scripts/run-roles-name-uniqueness-migration.mjs",
    "db:migrate:users-identity": "node scripts/run-users-identity-uniqueness-migration.mjs",
    "db:migrate:customer-id-sequences": "node scripts/run-customer-id-sequences-migration.mjs",
    "db:migrate:booking-workflows": "node scripts/apply-booking-workflows.mjs",
    "db:migrate:booking-document-split": "node scripts/run-booking-document-table-split.mjs",
    "db:migrate:booking-agents": "node scripts/run-booking-agent-import.mjs",
    "db:seed:import-export-forms": "node scripts/seed-import-export-booking-forms.mjs"
  },
